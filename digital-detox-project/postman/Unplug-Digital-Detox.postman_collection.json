{
  "info": {
    "_postman_id": "a7c2e1d4-8f3b-4c91-9e6a-digitaldetox01",
    "name": "Unplug — Digital Detox API",
    "description": "Integration requests for the Unplug REST API (`digital-detox-project`).\n\n**Prerequisites:** backend running on `http://localhost:8080` with PostgreSQL.\n\n**Suggested run order (demo flow):**\n1. Auth → Login as admin\n2. Members → Register member\n3. Coaches → Register coach\n4. Coaches → List pending coaches → Approve coach\n5. Auth → Login as coach\n6. Members → List members\n7. Plans → Create plan → Get plan → Add goal → Create review\n8. Auth → Login as member\n9. Check-ins → Create check-in → List check-ins\n10. Attachments → Upload (pick a file) → List → Download\n\nPublic requests disable auth. Protected requests send `Authorization: Bearer {{token}}`.\nRegister requests generate unique usernames via `runId` so the collection can be re-run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = Date.now().toString();",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('memberUsername', 'member_' + runId);",
          "  pm.collectionVariables.set('coachUsername', 'coach_' + runId);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "role", "value": "" },
    { "key": "memberUuid", "value": "" },
    { "key": "coachUuid", "value": "" },
    { "key": "planUuid", "value": "" },
    { "key": "checkInUuid", "value": "" },
    { "key": "attachmentUuid", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "Admin123!" },
    { "key": "memberUsername", "value": "" },
    { "key": "memberPassword", "value": "Member123!" },
    { "key": "coachUsername", "value": "" },
    { "key": "coachPassword", "value": "Coach123!" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login as admin returns 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Response has JWT and ADMIN role', () => {",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.role).to.eql('ADMIN');",
                  "});",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('role', json.role);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/authenticate",
            "description": "Public. Stores JWT in `token` for subsequent requests."
          }
        },
